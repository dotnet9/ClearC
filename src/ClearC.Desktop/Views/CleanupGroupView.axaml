<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClearC.Desktop.Controls"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             xmlns:views="using:ClearC.Desktop.Views"
             x:Class="ClearC.Desktop.Views.CleanupGroupView"
             x:DataType="vm:CleanupGroupViewModel">
  <StackPanel Margin="0,0,0,4">
    <ToggleButton Classes="ghead" IsChecked="{Binding IsExpanded}">
      <Grid ColumnDefinitions="14,9,*,Auto">
        <controls:IconGlyph Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center"
                            Data="{StaticResource ClearCIconChevron}"
                            Foreground="{DynamicResource ClearCText3}"
                            RenderTransformOrigin="50%,50%">
          <controls:IconGlyph.RenderTransform>
            <RotateTransform Angle="{Binding ChevronRotation}" />
          </controls:IconGlyph.RenderTransform>
        </controls:IconGlyph>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold"
                   Text="{Binding Name}" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock FontSize="11" Foreground="{DynamicResource ClearCText3}" Text="{Binding CountText}" />
          <TextBlock FontSize="12" FontWeight="SemiBold"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCAccent}" Text="{Binding SubtotalText}" />
        </StackPanel>
      </Grid>
    </ToggleButton>

    <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CleanupItemViewModel">
          <views:CleanupRowView />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

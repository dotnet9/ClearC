<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             xmlns:views="using:ClearC.Desktop.Views"
             x:Class="ClearC.Desktop.Views.CleanupDriveSectionView"
             x:DataType="vm:CleanupDriveSectionViewModel">
  <StackPanel Margin="0,0,0,10">
    <!-- 盘符分区头（原型 .ds-head）：盘符 + 类型 + 策略徽标 + 已选小计 + 可清理汇总 -->
    <Border Classes="dsHead" Margin="0,0,0,2">
      <Grid ColumnDefinitions="Auto,10,*,Auto,12,Auto,12,Auto">
        <Border Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center"
                Background="#FFE9F0FF"
                BorderBrush="#FFCDDDFF"
                BorderThickness="1"
                CornerRadius="7">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="13" FontWeight="Bold"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCAccent}" Text="{Binding DriveName}" />
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock FontSize="13" FontWeight="Bold" Text="{Binding DriveTitle}" />
          <TextBlock VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource ClearCText3}"
                     IsVisible="{Binding HasVolumeLabel}" Text="{Binding VolumeLabel}" />
        </StackPanel>
        <Border Grid.Column="3" Padding="9,2" VerticalAlignment="Center"
                Classes="dsPolicy" Classes.auto="{Binding IsPolicyAuto}">
          <TextBlock FontSize="10.5" Text="{Binding PolicyText}" />
        </Border>
        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"
                   FontFamily="{DynamicResource ClearCMonoFont}"
                   Foreground="{DynamicResource ClearCAccent}"
                   IsVisible="{Binding HasSelectedText}" Text="{Binding SelectedText}" />
        <TextBlock Grid.Column="7" VerticalAlignment="Center" FontSize="11"
                   FontFamily="{DynamicResource ClearCMonoFont}"
                   Foreground="{DynamicResource ClearCText3}"
                   IsVisible="{Binding HasSummaryText}" Text="{Binding SummaryText}" />
      </Grid>
    </Border>

    <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CleanupGroupViewModel">
          <views:CleanupGroupView />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

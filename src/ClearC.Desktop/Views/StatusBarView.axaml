<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             xmlns:i18n="using:CodeWF.Avalonia.Lang.MarkupExtensions"
             x:Class="ClearC.Desktop.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel">
  <Border Background="{DynamicResource ClearCStatusBg}"
          BorderBrush="{DynamicResource ClearCLine}"
          BorderThickness="0,1,0,0">
    <Grid Margin="14,0" ColumnDefinitions="*,Auto,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Ellipse Width="7" Height="7" Classes.blinkDot="{Binding IsStatusPulsing}" Fill="{Binding StatusBrush}" />
        <TextBlock FontSize="11" Foreground="{DynamicResource ClearCText2}" Text="{Binding StatusText}" />
      </StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0"
                 FontFamily="{DynamicResource ClearCMonoFont}"
                 Foreground="{DynamicResource ClearCText3}" Text="{Binding StateCode}" />
      <Button Grid.Column="2" Classes="mini" Content="{i18n:I18n ClearC.About.Title}"
              Command="{Binding AboutCommand}" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>

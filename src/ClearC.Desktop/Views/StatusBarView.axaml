<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             x:Class="ClearC.Desktop.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel">
  <Border Background="#66111B2E" BorderBrush="{DynamicResource ClearCLine}" BorderThickness="0,1,0,0">
    <Grid Margin="14,0" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" />
        <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5" LetterSpacing="0.5"
                   Foreground="{DynamicResource ClearCText2}" Text="{Binding StatusText}" />
      </StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                 FontSize="10.5" Foreground="{DynamicResource ClearCText3}" Text="{Binding StateCode}" />
    </Grid>
  </Border>
</UserControl>

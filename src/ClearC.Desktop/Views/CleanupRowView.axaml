<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClearC.Desktop.Controls"
             xmlns:sys="using:System"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             x:Class="ClearC.Desktop.Views.CleanupRowView"
             x:DataType="vm:CleanupItemViewModel">
  <StackPanel>
    <ToggleButton AutomationProperties.AutomationId="CleanupResultRow"
                  Classes="rowMain"
                  Classes.current="{Binding IsCurrent}"
                  Classes.expanded="{Binding IsExpanded}"
                  IsChecked="{Binding IsExpanded}">
      <ToggleButton.ContextMenu>
        <ContextMenu>
          <MenuItem Command="{Binding OpenLocationCommand}" Header="打开文件（夹）所在目录" />
          <MenuItem Command="{Binding CopyPathCommand}" Header="复制完整路径" />
          <MenuItem Command="{Binding ToggleSelectionCommand}"
                    Header="{Binding ContextToggleText}"
                    IsVisible="{Binding CanSelect}" />
          <MenuItem Command="{Binding ToggleExpandedCommand}" Header="{Binding ContextExpandText}" />
        </ContextMenu>
      </ToggleButton.ContextMenu>
      <Grid ColumnDefinitions="22,34,12,*,Auto,158,92,64,30,14">
        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding SelectionToolTip}"
                  IsChecked="{Binding IsSelected}"
                  IsEnabled="{Binding CanSelect}" />
        <Border Grid.Column="1" Width="34" Height="34" VerticalAlignment="Center"
                Background="{Binding TileBackground}"
                BorderBrush="{Binding TileBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ClearCRadiusTile}">
          <controls:IconGlyph Width="17" Height="17"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IconKey="{Binding IconKey}"
                              Foreground="{Binding AccentBrush}" />
        </Border>

        <StackPanel Grid.Column="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Text="{Binding DisplayName}" />
            <Border Padding="8,1.5" VerticalAlignment="Center"
                    Background="{DynamicResource ClearCTagBg}"
                    CornerRadius="{DynamicResource ClearCRadiusPill}"
                    IsVisible="{Binding HasReadOnlyTag}">
              <TextBlock FontSize="10.5" Foreground="{DynamicResource ClearCText3}"
                         Text="{Binding ReadOnlyText}" />
            </Border>
          </StackPanel>
          <TextBlock Margin="0,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText3}"
                     ToolTip.Tip="{Binding Location}"
                     Text="{Binding Location}" />
        </StackPanel>

        <Border Grid.Column="4" Margin="12,0" Padding="9,2" VerticalAlignment="Center"
                Background="{Binding RiskBackground}"
                CornerRadius="{DynamicResource ClearCRadiusPill}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding RiskForeground}" />
            <TextBlock FontSize="11" Foreground="{Binding RiskForeground}" Text="{Binding RiskText}" />
          </StackPanel>
        </Border>

        <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="11" TextTrimming="CharacterEllipsis"
                   FontFamily="{DynamicResource ClearCMonoFont}"
                   Foreground="{DynamicResource ClearCText3}" Text="{Binding MetaText}" />

        <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="Bold"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText}" Text="{Binding SizeText}" />
          <TextBlock HorizontalAlignment="Right" FontSize="10"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCGreen}" Text="{Binding FreedText}" />
        </StackPanel>

        <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="11" FontWeight="SemiBold"
                   Foreground="{Binding ResultBrush}" Text="{Binding ResultText}" />

        <Button Grid.Column="8" Classes="rowOpen" VerticalAlignment="Center"
                Command="{Binding OpenLocationCommand}"
                ToolTip.Tip="打开文件（夹）所在目录">
          <controls:IconGlyph Width="13" Height="13"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="{StaticResource ClearCIconFolder}"
                              Foreground="{DynamicResource ClearCText3}" />
        </Button>

        <controls:IconGlyph Grid.Column="9" Width="14" Height="14" VerticalAlignment="Center"
                            Data="{StaticResource ClearCIconChevron}"
                            Foreground="{DynamicResource ClearCText3}"
                            RenderTransformOrigin="50%,50%">
          <controls:IconGlyph.RenderTransform>
            <RotateTransform Angle="{Binding ChevronRotation}" />
          </controls:IconGlyph.RenderTransform>
        </controls:IconGlyph>
      </Grid>
    </ToggleButton>

    <Border Classes="rowDetail"
            Classes.open="{Binding IsExpanded}"
            Margin="76,0,12,6" Padding="14,10"
            Background="{DynamicResource ClearCPanel}"
            BorderBrush="{DynamicResource ClearCLine}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ClearCRadiusButton}"
            IsVisible="{Binding IsExpanded}">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Width="34" FontSize="11" FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText3}" Text="说明" />
          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}"
                     Text="{Binding Description}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Width="34" FontSize="11" FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText3}" Text="路径" />
          <StackPanel>
            <ItemsControl ItemsSource="{Binding PathLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock FontSize="11" FontFamily="{DynamicResource ClearCMonoFont}"
                             Foreground="{DynamicResource ClearCAccent}" Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource ClearCText3}"
                         IsVisible="{Binding HasPathSource}" Text="{Binding PathSourceText}" />
              <Button Classes="mini" Command="{Binding OpenLocationCommand}" Content="打开位置"
                      ToolTip.Tip="在资源管理器中定位这个清理路径" />
            </StackPanel>
            <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource ClearCAmber}"
                       IsVisible="{Binding HasLocationHint}" Text="{Binding LocationHint}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Width="34" FontSize="11" FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText3}" Text="建议" />
          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}"
                     Text="{Binding Recommendation}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasScanNote}">
          <TextBlock Width="34" FontSize="11" FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText3}" Text="备注" />
          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCAmber}"
                     Text="{Binding ScanNoteText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDenied}">
          <TextBlock Width="34" FontSize="11" FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText3}" Text="拒绝" />
          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCRed}"
                     Text="{Binding DeniedReason}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>

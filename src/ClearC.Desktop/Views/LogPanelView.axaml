<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="https://codewf.com"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             x:Class="ClearC.Desktop.Views.LogPanelView"
             x:DataType="vm:LogPanelViewModel">
  <Border Background="#04070D" BorderBrush="{DynamicResource ClearCLine}" BorderThickness="0,1,0,0">
    <Grid RowDefinitions="34,*">
      <Border Grid.Row="0" Background="#66111B2E" BorderBrush="#1A38BDF8" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,8,0">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Rectangle Width="7" Height="7" Fill="{DynamicResource ClearCCyan}" />
            <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5" LetterSpacing="1"
                       Foreground="{DynamicResource ClearCText2}" Text="运行日志" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Padding="14,8,14,10" Background="#F4F7FA">
        <log:LogView FontFamily="{DynamicResource ClearCMonoFont}"
                     FontSize="11.5"
                     LogLineHeightMultiplier="1.35"
                     MaxDisplayCount="1000"
                     MaximumLevel="Critical"
                     MinimumLevel="Information"
                     TimestampFormat="HH:mm:ss" />
      </Border>
    </Grid>
  </Border>
</UserControl>

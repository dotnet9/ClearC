<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             x:Class="ClearC.Desktop.Views.LogPanelView"
             x:DataType="vm:LogPanelViewModel">
  <Border Background="#04070D" BorderBrush="{DynamicResource ClearCLine}" BorderThickness="0,1,0,0">
    <Grid RowDefinitions="34,*">
      <Border Grid.Row="0" Background="#66111B2E" BorderBrush="#1A38BDF8" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,8,0" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Rectangle Width="7" Height="7" Fill="{DynamicResource ClearCCyan}" />
            <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5" LetterSpacing="1"
                       Foreground="{DynamicResource ClearCText2}" Text="运行日志" />
            <Border Padding="7,0" CornerRadius="3" Background="#1A22D3EE">
              <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                         Foreground="{DynamicResource ClearCCyanBright}" Text="{Binding LogCount}" />
            </Border>
          </StackPanel>
          <Button Grid.Column="1" Classes="mini" Command="{Binding ClearLogsCommand}" Content="清空" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="LogScroller" Grid.Row="1" Margin="14,8,14,10" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Logs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogEntryViewModel">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Width="54" FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                           Foreground="#5D7194" Text="{Binding Time}" />
                <TextBlock Width="36" FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5" FontWeight="Bold"
                           Foreground="{Binding LevelBrush}" Text="{Binding Level}" />
                <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                           Foreground="#B9CDE6" Text="{Binding Message}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClearC.Desktop.ViewModels"
        xmlns:views="using:ClearC.Desktop.Views"
        x:Class="ClearC.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ClearC"
        Icon="avares://ClearC.Desktop/Assets/logo.ico"
        Width="1060"
        Height="700"
        MinWidth="960"
        MinHeight="620"
        Background="Transparent"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">
  <Border Classes="windowRoot"
          Background="{DynamicResource ClearCWin}"
          BorderBrush="{DynamicResource ClearCWindowBorder}"
          BorderThickness="1"
          BoxShadow="0 30 80 0 #29172B63, 0 2 8 0 #0F172B63"
          ClipToBounds="True"
          CornerRadius="{DynamicResource ClearCRadiusWindow}">
    <Grid RowDefinitions="44,*,160,28">
      <views:TitleBarView Grid.Row="0" DataContext="{Binding TitleBar}" />
      <views:CleanupWorkspaceView Grid.Row="1" DataContext="{Binding Workspace}" />
      <views:LogPanelView Grid.Row="2" DataContext="{Binding LogPanel}" />
      <views:StatusBarView Grid.Row="3" DataContext="{Binding StatusBar}" />
      <views:WorkflowOverlayView Grid.RowSpan="4" DataContext="{Binding Overlay}" />
    </Grid>
  </Border>
</Window>

<codewf:CodeWFWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:codewf="https://codewf.com"
        xmlns:controls="using:ClearC.Desktop.Controls"
        xmlns:i18n="using:CodeWF.Avalonia.Lang.MarkupExtensions"
        xmlns:vm="using:ClearC.Desktop.ViewModels"
        xmlns:views="using:ClearC.Desktop.Views"
        xmlns:l="using:ClearC.Desktop.I18n"
        x:Class="ClearC.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ClearC"
        Icon="avares://ClearC.Desktop/Assets/logo.ico"
        Width="1060"
        Height="700"
        TitleBarHeight="{DynamicResource ClearCTitleBarHeight}"
        CaptionButtonWidth="44"
        TitleBarBackground="{DynamicResource ClearCWin}"
        TitleBarBorderBrush="{DynamicResource ClearCLine}"
        MinWidth="960"
        MinHeight="620"
        Background="{DynamicResource ClearCWin}"
        BorderBrush="{DynamicResource ClearCWindowBorder}"
        BorderThickness="1"
        WindowCornerRadius="{DynamicResource ClearCRadiusWindow}"
        WindowStartupLocation="CenterScreen">
  <codewf:CodeWFWindow.LeftContent>
    <!-- 品牌区（原 TitleBarView） -->
    <StackPanel Margin="6,0,0,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <Border Width="24" Height="24" VerticalAlignment="Center"
              Background="{DynamicResource ClearCAccentGradient}"
              BoxShadow="0 2 8 0 #592F6BFF"
              CornerRadius="{DynamicResource ClearCRadius}">
        <controls:IconGlyph Width="14" Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource ClearCIconLogo}"
                            Filled="True"
                            Foreground="White" />
      </Border>
      <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" LetterSpacing="0.5"
                 Text="{Binding TitleBar.ProductName}" />
      <TextBlock VerticalAlignment="Center" FontSize="11.5"
                 Foreground="{DynamicResource ClearCText3}" Text="{Binding TitleBar.Tagline}" />
    </StackPanel>
  </codewf:CodeWFWindow.LeftContent>
  <codewf:CodeWFWindow.RightContent>
    <Grid ColumnDefinitions="104,Auto,148,116" ColumnSpacing="6" Margin="0,0,8,0"
          DataContext="{Binding Appearance}" x:DataType="vm:AppearanceViewModel" VerticalAlignment="Center">
      <ComboBox Height="28" MinHeight="0" Padding="8,0" ItemsSource="{Binding Modes}"
                SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Mode, Mode=TwoWay}"
                DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                ToolTip.Tip="{i18n:I18n {x:Static l:Language.AppearanceMode}}" />
      <ListBox Grid.Column="1" Classes="paletteSwatches" ItemsSource="{Binding Palettes}"
               SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Palette, Mode=TwoWay}"
               AutoScrollToSelectedItem="False">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PaletteChoice">
            <Ellipse Width="12" Height="12" Fill="{Binding PreviewBrush}" ToolTip.Tip="{Binding DisplayName}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ComboBox Grid.Column="2" Height="28" MinHeight="0" Padding="8,0" ItemsSource="{Binding Palettes}"
                SelectedValueBinding="{Binding Value}" SelectedValue="{Binding Palette, Mode=TwoWay}"
                DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                ToolTip.Tip="{i18n:I18n {x:Static l:Language.AppearancePalette}}" />
      <ComboBox Grid.Column="3" Height="28" MinHeight="0" Padding="8,0" ItemsSource="{Binding Languages}"
                SelectedValueBinding="{Binding Value}" SelectedValue="{Binding CultureName, Mode=TwoWay}"
                DisplayMemberBinding="{Binding DisplayName}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                ToolTip.Tip="{i18n:I18n {x:Static l:Language.AppearanceLanguage}}" />
    </Grid>
  </codewf:CodeWFWindow.RightContent>
  <Grid RowDefinitions="Auto,*,160,28">
    <Border x:Name="PlatformNoticeBanner" Grid.Row="0" IsVisible="False"
            Background="{DynamicResource ClearCWarnBg}" BorderBrush="{DynamicResource ClearCWarnBorder}" BorderThickness="0,1"
            Padding="14,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource ClearCWarnText}"
                   Text="{i18n:I18n ClearC.PlatformNotice}" />
        <Button Grid.Column="1" Content="{i18n:I18n ClearC.Dismiss}" Margin="12,0,0,0" Padding="10,4"
                Click="OnPlatformNoticeDismiss" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <views:CleanupWorkspaceView Grid.Row="1" DataContext="{Binding Workspace}" />
    <views:LogPanelView Grid.Row="2" DataContext="{Binding LogPanel}" />
    <views:StatusBarView Grid.Row="3" DataContext="{Binding StatusBar}" />
    <views:WorkflowOverlayView Grid.RowSpan="4" DataContext="{Binding Overlay}" />
  </Grid>
</codewf:CodeWFWindow>

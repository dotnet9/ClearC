<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ClearC.Desktop.Controls"
        xmlns:vm="using:ClearC.Desktop.ViewModels"
        x:Class="ClearC.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ClearC"
        Icon="avares://ClearC.Desktop/Assets/logo.ico"
        Width="1060"
        Height="700"
        MinWidth="960"
        MinHeight="620"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
  <Border Background="#FA060A12"
          BorderBrush="{DynamicResource ClearCLineStrong}"
          BorderThickness="1"
          CornerRadius="10"
          ClipToBounds="True">
    <Grid RowDefinitions="42,*,160,28">
      <Border Grid.Row="0"
              Background="#80111B2E"
              BorderBrush="{DynamicResource ClearCLine}"
              BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_OnPointerPressed">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Margin="14,0,0,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Width="24" Height="24" Source="avares://ClearC.Desktop/Assets/logo.png" />
            <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                       FontSize="13" FontWeight="Bold" LetterSpacing="2.5"
                       Foreground="{DynamicResource ClearCCyanBright}" Text="CLEARC" />
            <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                       FontSize="11" Foreground="{DynamicResource ClearCText2}"
                       Text="// C盘清理引擎" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Classes="titleButton" Click="Minimize_OnClick" ToolTip.Tip="最小化" Content="−" />
            <Button Classes="titleButton" Click="Maximize_OnClick" ToolTip.Tip="最大化或还原" Content="□" />
            <Button Classes="titleButton close" Click="Close_OnClick" ToolTip.Tip="关闭" Content="×" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="174,35,*">
        <Grid Grid.Row="0" Margin="26,18,26,14" ColumnDefinitions="132,30,*">
          <Grid Width="132" Height="132">
            <controls:DiskDonut UsedRatio="{Binding UsedRatio}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
              <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                         FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ClearCCyanBright}"
                         Text="{Binding UsedPercent}" />
              <TextBlock HorizontalAlignment="Center" FontSize="10.5" LetterSpacing="2"
                         Foreground="{DynamicResource ClearCText2}" Text="已用" />
            </StackPanel>
            <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top"
                    BorderBrush="#8C67E8F9" BorderThickness="1.5,1.5,0,0" />
            <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderBrush="#8C67E8F9" BorderThickness="0,0,1.5,1.5" />
          </Grid>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding DriveTitle}" />
              <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                         FontSize="11" Foreground="{DynamicResource ClearCText2}" Text="{Binding DriveInfo}" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
              <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="12"
                         Foreground="{DynamicResource ClearCText2}" Text="{Binding HeroLabel}" />
              <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="28" FontWeight="Bold"
                         Foreground="{DynamicResource ClearCCyanBright}" Text="{Binding HeroValue}" />
            </StackPanel>
            <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="12"
                       Foreground="{DynamicResource ClearCText2}" Text="{Binding DiskUsage}" />
            <StackPanel Margin="0,13,0,0" Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Command="{Binding PrimaryCommand}"
                      IsEnabled="{Binding IsPrimaryEnabled}" Content="{Binding PrimaryButtonText}" />
              <Button Classes="ghost" Command="{Binding SecondaryCommand}"
                      IsEnabled="{Binding IsSecondaryEnabled}" Content="{Binding SecondaryButtonText}" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="12"
                        IsVisible="{Binding IsProgressVisible}">
              <ProgressBar Width="230" Height="4" Minimum="0" Maximum="100"
                           Foreground="{DynamicResource ClearCCyan}" Background="#1F38BDF8"
                           Value="{Binding ProgressValue}" />
              <TextBlock MaxWidth="390" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                         Foreground="{DynamicResource ClearCText2}" Text="{Binding ProgressText}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="26,0,26,10" ColumnDefinitions="*,Auto">
          <ItemsControl ItemsSource="{Binding Filters}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryFilterViewModel">
                <Button Margin="0,0,7,0" Classes="chip" Classes.active="{Binding IsActive}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectFilterCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5"
                               Foreground="{DynamicResource ClearCText2}" Text="{Binding Count}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                       FontSize="11.5" Foreground="{DynamicResource ClearCText2}"
                       Text="{Binding SelectedSummary}" />
            <CheckBox VerticalAlignment="Center" Content="全选"
                      Foreground="{DynamicResource ClearCText2}"
                      IsEnabled="{Binding CanSelectAll}"
                      IsChecked="{Binding IsAllSelected}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                      IsVisible="{Binding IsEmptyVisible}">
            <Border Width="58" Height="58" CornerRadius="14" BorderBrush="#5938BDF8"
                    BorderThickness="1" Background="#0F22D3EE">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                         Foreground="{DynamicResource ClearCCyan}" Text="□" />
            </Border>
            <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource ClearCText2}" Text="尚未分析" />
            <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                       FontSize="11" Foreground="{DynamicResource ClearCText2}"
                       Text="// 等待扫描指令 · 点击「扫描分析」" />
          </StackPanel>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                      IsVisible="{Binding IsScanningEmptyVisible}">
            <ProgressBar Width="180" Height="4" IsIndeterminate="True" Foreground="{DynamicResource ClearCCyan}" />
            <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                       Foreground="{DynamicResource ClearCCyan}" Text="正在定位缓存与临时文件 …" />
          </StackPanel>

          <ScrollViewer Margin="16,0,16,10" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding IsListVisible}">
            <ItemsControl ItemsSource="{Binding VisibleItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanupItemViewModel">
                  <StackPanel Opacity="{Binding RowOpacity}">
                    <ToggleButton Classes="cleanupRow" IsChecked="{Binding IsExpanded}">
                      <Grid ColumnDefinitions="22,34,12,*,82,140,92,78,14">
                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                  IsEnabled="{Binding CanSelect}" IsChecked="{Binding IsSelected}" />
                        <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8"
                                Background="#1422D3EE" BorderBrush="{Binding AccentBrush}" BorderThickness="1">
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontFamily="{DynamicResource ClearCMonoFont}" FontSize="17"
                                     Foreground="{Binding AccentBrush}" Text="{Binding IconGlyph}" />
                        </Border>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                            <Border Padding="6,1" CornerRadius="3" BorderBrush="{DynamicResource ClearCLine}"
                                    BorderThickness="1" IsVisible="{Binding IsReadOnly}">
                              <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10"
                                         Foreground="{DynamicResource ClearCText2}" Text="{Binding ReadOnlyText}" />
                            </Border>
                          </StackPanel>
                          <TextBlock MaxWidth="400" TextTrimming="CharacterEllipsis"
                                     FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                     Foreground="{DynamicResource ClearCText2}" Text="{Binding Location}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Ellipse Width="6" Height="6" Fill="{Binding RiskBrush}" />
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5"
                                     Foreground="{DynamicResource ClearCText2}" Text="{Binding RiskText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                   Foreground="{DynamicResource ClearCText3}" Text="{Binding FileCountText}" />
                        <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="13" FontWeight="SemiBold"
                                     Text="{Binding SizeText}" />
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10"
                                     Foreground="{DynamicResource ClearCGreen}" Text="{Binding FreedText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5"
                                   Foreground="{Binding ResultBrush}" Text="{Binding ResultText}" />
                        <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource ClearCMonoFont}" FontSize="12"
                                   Foreground="{DynamicResource ClearCText3}" Text="⌄" />
                      </Grid>
                    </ToggleButton>
                    <Border Margin="76,0,12,6" Padding="14,9" CornerRadius="6"
                            Background="#CC0D1524" BorderBrush="{DynamicResource ClearCLine}"
                            BorderThickness="2,1,1,1" IsVisible="{Binding IsExpanded}">
                      <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                     Foreground="{DynamicResource ClearCText2}" Text="说明" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}"
                                     Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                     Foreground="{DynamicResource ClearCText2}" Text="路径" />
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                     Foreground="{DynamicResource ClearCCyan}" Text="{Binding Location}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                     Foreground="{DynamicResource ClearCText2}" Text="建议" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}"
                                     Text="{Binding Recommendation}" TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="#04070D" BorderBrush="{DynamicResource ClearCLine}" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="34,*">
          <Border Grid.Row="0" Background="#66111B2E" BorderBrush="#1A38BDF8" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,8,0" ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Rectangle Width="7" Height="7" Fill="{DynamicResource ClearCCyan}" />
                <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5" LetterSpacing="1"
                           Foreground="{DynamicResource ClearCText2}" Text="运行日志" />
                <Border Padding="7,0" CornerRadius="3" Background="#1A22D3EE">
                  <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                             Foreground="{DynamicResource ClearCCyanBright}" Text="{Binding LogCount}" />
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Classes="mini" Command="{Binding ClearLogsCommand}" Content="清空" />
            </Grid>
          </Border>
          <ScrollViewer x:Name="LogScroller" Grid.Row="1" Margin="14,8,14,10" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Logs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntryViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Width="54" FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                               Foreground="#5D7194" Text="{Binding Time}" />
                    <TextBlock Width="36" FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5" FontWeight="Bold"
                               Foreground="{Binding LevelBrush}" Text="{Binding Level}" />
                    <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                               Foreground="#B9CDE6" Text="{Binding Message}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="3" Background="#66111B2E" BorderBrush="{DynamicResource ClearCLine}" BorderThickness="0,1,0,0">
        <Grid Margin="14,0" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" />
            <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5" LetterSpacing="0.5"
                       Foreground="{DynamicResource ClearCText2}" Text="{Binding StatusText}" />
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                     FontSize="10.5" Foreground="{DynamicResource ClearCText3}" Text="{Binding StateCode}" />
        </Grid>
      </Border>

      <Border Grid.RowSpan="4" Background="#B503060C" IsVisible="{Binding IsConfirmationVisible}">
        <Border Width="420" MaxHeight="510" Padding="22,20,22,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="10" Background="{DynamicResource ClearCBg1}"
                BorderBrush="{DynamicResource ClearCLineStrong}" BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold" Text="确认清理" />
            <Border Grid.Row="1" Width="34" Height="2" Margin="0,7,0,10" HorizontalAlignment="Left"
                    Background="{DynamicResource ClearCCyan}" />
            <StackPanel Grid.Row="2" Spacing="9">
              <TextBlock FontSize="12.5" Foreground="{DynamicResource ClearCText2}"
                         Text="即将清理以下项目：" />
              <Border MaxHeight="220" Padding="12,7" CornerRadius="6"
                      Background="#990D1524" BorderBrush="{DynamicResource ClearCLine}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SelectedItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CleanupItemViewModel">
                        <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                          <TextBlock Foreground="{DynamicResource ClearCText2}" Text="{Binding DisplayName}" />
                          <TextBlock Grid.Column="1" FontFamily="{DynamicResource ClearCMonoFont}" FontWeight="SemiBold"
                                     Text="{Binding SizeText}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
              <TextBlock FontWeight="SemiBold" Text="合计释放" />
              <TextBlock Grid.Column="1" FontFamily="{DynamicResource ClearCMonoFont}" FontWeight="Bold"
                         Foreground="{DynamicResource ClearCCyanBright}" Text="{Binding ConfirmationTotal}" />
            </Grid>
            <Border Grid.Row="4" Margin="0,10,0,0" Padding="10" CornerRadius="6"
                    Background="#14FBBF24" BorderBrush="#4DFBBF24" BorderThickness="1">
              <TextBlock FontSize="12" Foreground="{DynamicResource ClearCAmber}"
                         Text="{Binding ConfirmationWarning}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Grid.Row="5" Margin="0,16,0,0" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right">
              <Button Classes="ghost" Command="{Binding CancelConfirmationCommand}" Content="取消" />
              <Button Classes="primary" Command="{Binding ConfirmCleanupCommand}" Content="开始清理" />
            </StackPanel>
          </Grid>
        </Border>
      </Border>

      <Border Grid.RowSpan="4" Margin="0,0,18,18" Padding="16,11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              CornerRadius="7" Background="{DynamicResource ClearCBg1}" BorderBrush="{DynamicResource ClearCGreen}"
              BorderThickness="3,1,1,1" IsVisible="{Binding IsToastVisible}">
        <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5" Text="{Binding ToastText}" />
      </Border>
    </Grid>
  </Border>
</Window>

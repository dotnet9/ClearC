<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClearC.Desktop.Controls"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             xmlns:views="using:ClearC.Desktop.Views"
             x:Class="ClearC.Desktop.Views.CleanupWorkspaceView"
             x:DataType="vm:CleanupWorkspaceViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <!-- ═══ 总览区 ═══ -->
    <Grid Grid.Row="0" Margin="26,20,26,18" ColumnDefinitions="150,30,*">
      <Grid Width="150" Height="150">
        <controls:DiskDonut UsedRatio="{Binding UsedRatio}"
                            AccentBrush="{DynamicResource ClearCAccentGradient}"
                            TrackBrush="{DynamicResource ClearCDonutTrack}"
                            StrokeThickness="9" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
          <TextBlock HorizontalAlignment="Center" FontSize="23" FontWeight="ExtraBold"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCAccent}" Text="{Binding UsedPercent}" />
          <TextBlock HorizontalAlignment="Center" FontSize="10.5" LetterSpacing="2"
                     Foreground="{DynamicResource ClearCText3}" Text="已用" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding DriveTitle}" />
          <TextBlock VerticalAlignment="Center" FontSize="11"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCText3}" Text="{Binding DriveInfo}" />
        </StackPanel>

        <StackPanel Margin="0,9,0,3" Orientation="Horizontal" Spacing="12">
          <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="12"
                     Foreground="{DynamicResource ClearCText2}" Text="{Binding HeroLabel}" />
          <TextBlock FontSize="26" FontWeight="ExtraBold" LetterSpacing="-0.5"
                     FontFamily="{DynamicResource ClearCMonoFont}"
                     Foreground="{DynamicResource ClearCAccent}"
                     IsVisible="{Binding !IsHeroPlaceholder}" Text="{Binding HeroValue}" />
          <TextBlock FontSize="16" FontWeight="Normal"
                     Foreground="{DynamicResource ClearCText3}"
                     IsVisible="{Binding IsHeroPlaceholder}" Text="{Binding HeroValue}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}" Text="已用" />
          <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DiskUsedText}" />
          <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}" Text="·  可用" />
          <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DiskFreeText}" />
        </StackPanel>

        <StackPanel Margin="0,15,0,0" Orientation="Horizontal" Spacing="10">
          <Grid>
            <Border Classes="btnGlow"
                    Margin="-3"
                    Background="{DynamicResource ClearCAccentGradient}"
                    CornerRadius="{DynamicResource ClearCRadiusButton}"
                    IsVisible="{Binding IsPrimaryGlowing}" />
            <Button Classes="btn primary" Command="{Binding PrimaryCommand}" IsEnabled="{Binding IsPrimaryEnabled}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:IconGlyph Width="15" Height="15" IconKey="{Binding PrimaryIconKey}" Foreground="White" />
                <TextBlock VerticalAlignment="Center" Text="{Binding PrimaryButtonText}" />
              </StackPanel>
            </Button>
          </Grid>
          <Button Classes="btn ghost" Command="{Binding SecondaryCommand}"
                  IsEnabled="{Binding IsSecondaryEnabled}" Content="{Binding SecondaryButtonText}" />
        </StackPanel>

        <StackPanel Margin="0,13,0,0" Orientation="Horizontal" Spacing="12"
                    IsVisible="{Binding IsProgressVisible}">
          <Border Width="230" Height="6" VerticalAlignment="Center"
                  Background="{DynamicResource ClearCProgressTrack}"
                  CornerRadius="{DynamicResource ClearCRadiusPill}">
            <Border Width="{Binding ProgressBarWidth}" HorizontalAlignment="Left"
                    Background="{DynamicResource ClearCAccentGradient}"
                    CornerRadius="{DynamicResource ClearCRadiusPill}" />
          </Border>
          <TextBlock MaxWidth="330" VerticalAlignment="Center" FontSize="11.5"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource ClearCText2}" Text="{Binding ProgressText}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ═══ 提权提示条（§7.1） ═══ -->
    <Border Grid.Row="1" Margin="26,0,26,10" Padding="12,8"
            Background="{DynamicResource ClearCWarnBg}"
            BorderBrush="{DynamicResource ClearCWarnBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ClearCRadiusButton}"
            IsVisible="{Binding IsElevationBannerVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <controls:IconGlyph Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center"
                            Data="{StaticResource ClearCIconAlert}"
                            Foreground="{DynamicResource ClearCWarnText}" />
        <TextBlock Grid.Column="1" Margin="9,0" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource ClearCWarnText}" Text="{Binding ElevationBannerText}" />
        <Button Grid.Column="2" Classes="mini" Command="{Binding RestartElevatedCommand}" Content="以管理员重启" />
      </Grid>
    </Border>

    <!-- ═══ 分组栏 ═══ -->
    <Grid Grid.Row="2" Margin="26,0,26,10" ColumnDefinitions="Auto,*,Auto">
      <CheckBox Grid.Column="0" VerticalAlignment="Center" Content="全选"
                IsEnabled="{Binding CanSelectAll}" IsChecked="{Binding IsAllSelected}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center" FontSize="11.5"
                   Foreground="{DynamicResource ClearCText2}" Text="{Binding SelectedSummary}" />
        <CheckBox VerticalAlignment="Center" FontSize="11.5" Content="隐藏 0 字节项"
                  IsChecked="{Binding HideZeroByteItems}" />
      </StackPanel>
    </Grid>

    <!-- ═══ 结果列表 ═══ -->
    <views:CleanupListView Grid.Row="3" />
  </Grid>
</UserControl>

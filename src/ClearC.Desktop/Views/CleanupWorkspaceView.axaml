<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClearC.Desktop.Controls"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             x:Class="ClearC.Desktop.Views.CleanupWorkspaceView"
             x:DataType="vm:CleanupWorkspaceViewModel">
  <Grid RowDefinitions="174,35,*">
    <Grid Grid.Row="0" Margin="26,18,26,14" ColumnDefinitions="132,30,*">
      <Grid Width="132" Height="132">
        <controls:DiskDonut UsedRatio="{Binding UsedRatio}" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
          <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                     FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ClearCCyanBright}"
                     Text="{Binding UsedPercent}" />
          <TextBlock HorizontalAlignment="Center" FontSize="10.5" LetterSpacing="2"
                     Foreground="{DynamicResource ClearCText2}" Text="已用" />
        </StackPanel>
        <Border Width="15" Height="15" HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderBrush="#8C67E8F9" BorderThickness="1.5,1.5,0,0" />
        <Border Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                BorderBrush="#8C67E8F9" BorderThickness="0,0,1.5,1.5" />
      </Grid>

      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding DriveTitle}" />
          <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                     FontSize="11" Foreground="{DynamicResource ClearCText2}" Text="{Binding DriveInfo}" />
        </StackPanel>
        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
          <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="12"
                     Foreground="{DynamicResource ClearCText2}" Text="{Binding HeroLabel}" />
          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="28" FontWeight="Bold"
                     Foreground="{DynamicResource ClearCCyanBright}" Text="{Binding HeroValue}" />
        </StackPanel>
        <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="12"
                   Foreground="{DynamicResource ClearCText2}" Text="{Binding DiskUsage}" />
        <StackPanel Margin="0,13,0,0" Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Command="{Binding PrimaryCommand}"
                  IsEnabled="{Binding IsPrimaryEnabled}" Content="{Binding PrimaryButtonText}" />
          <Button Classes="ghost" Command="{Binding SecondaryCommand}"
                  IsEnabled="{Binding IsSecondaryEnabled}" Content="{Binding SecondaryButtonText}" />
        </StackPanel>
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="12"
                    IsVisible="{Binding IsProgressVisible}">
          <ProgressBar Width="230" Height="4" Minimum="0" Maximum="100"
                       Foreground="{DynamicResource ClearCCyan}" Background="#1F38BDF8"
                       Value="{Binding ProgressValue}" />
          <TextBlock MaxWidth="390" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                     Foreground="{DynamicResource ClearCText2}" Text="{Binding ProgressText}" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="26,0,26,10" ColumnDefinitions="*,Auto">
      <ItemsControl ItemsSource="{Binding Filters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryFilterViewModel">
            <Button Margin="0,0,7,0" Classes="chip" Classes.active="{Binding IsActive}"
                    Command="{Binding $parent[UserControl].((vm:CleanupWorkspaceViewModel)DataContext).SelectFilterCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding Label}" />
                <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5"
                           Foreground="{DynamicResource ClearCText2}" Text="{Binding Count}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                   FontSize="11.5" Foreground="{DynamicResource ClearCText2}"
                   Text="{Binding SelectedSummary}" />
        <CheckBox VerticalAlignment="Center" Content="全选"
                  Foreground="{DynamicResource ClearCText2}"
                  IsEnabled="{Binding CanSelectAll}"
                  IsChecked="{Binding IsAllSelected}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding IsEmptyVisible}">
        <Border Width="58" Height="58" CornerRadius="14" BorderBrush="#5938BDF8"
                BorderThickness="1" Background="#0F22D3EE">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                     Foreground="{DynamicResource ClearCCyan}" Text="□" />
        </Border>
        <TextBlock HorizontalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource ClearCText2}" Text="尚未分析" />
        <TextBlock HorizontalAlignment="Center" FontFamily="{DynamicResource ClearCMonoFont}"
                   FontSize="11" Foreground="{DynamicResource ClearCText2}"
                   Text="// 等待扫描指令 · 点击「扫描分析」" />
      </StackPanel>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                  IsVisible="{Binding IsScanningEmptyVisible}">
        <ProgressBar Width="180" Height="4" IsIndeterminate="True" Foreground="{DynamicResource ClearCCyan}" />
        <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5"
                   Foreground="{DynamicResource ClearCCyan}" Text="正在定位缓存与临时文件 …" />
      </StackPanel>

      <DataGrid Margin="16,0,16,10"
                Classes="cleanupGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                BorderThickness="0"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="None"
                HeadersVisibility="None"
                HorizontalScrollBarVisibility="Disabled"
                IsReadOnly="True"
                IsVisible="{Binding IsListVisible}"
                ItemsSource="{Binding VisibleItems}"
                SelectionMode="Single"
                VerticalScrollBarVisibility="Auto">
        <DataGrid.CellTheme>
          <ControlTheme TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
          </ControlTheme>
        </DataGrid.CellTheme>
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:CleanupItemViewModel">
                <StackPanel HorizontalAlignment="Stretch" Opacity="{Binding RowOpacity}">
                <ToggleButton AutomationProperties.AutomationId="CleanupResultRow"
                              Classes="cleanupRow" IsChecked="{Binding IsExpanded}">
                  <Grid ColumnDefinitions="22,34,12,*,82,140,92,78,14">
                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                              IsEnabled="{Binding CanSelect}" IsChecked="{Binding IsSelected}" />
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8"
                            Background="#1422D3EE" BorderBrush="{Binding AccentBrush}" BorderThickness="1">
                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontFamily="{DynamicResource ClearCMonoFont}" FontSize="17"
                                 Foreground="{Binding AccentBrush}" Text="{Binding IconGlyph}" />
                    </Border>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <Border Padding="6,1" CornerRadius="3" BorderBrush="{DynamicResource ClearCLine}"
                                BorderThickness="1" IsVisible="{Binding IsReadOnly}">
                          <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10"
                                     Foreground="{DynamicResource ClearCText2}" Text="{Binding ReadOnlyText}" />
                        </Border>
                      </StackPanel>
                      <TextBlock MaxWidth="400" TextTrimming="CharacterEllipsis"
                                 FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                 Foreground="{DynamicResource ClearCText2}" Text="{Binding Location}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="{Binding RiskBrush}" />
                      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5"
                                 Foreground="{DynamicResource ClearCText2}" Text="{Binding RiskText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                               Foreground="{DynamicResource ClearCText3}" Text="{Binding FileCountText}" />
                    <StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="13" FontWeight="SemiBold"
                                 Text="{Binding SizeText}" />
                      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10"
                                 Foreground="{DynamicResource ClearCGreen}" Text="{Binding FreedText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{DynamicResource ClearCMonoFont}" FontSize="10.5"
                               Foreground="{Binding ResultBrush}" Text="{Binding ResultText}" />
                    <TextBlock Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{DynamicResource ClearCMonoFont}" FontSize="12"
                               Foreground="{DynamicResource ClearCText3}" Text="⌄" />
                  </Grid>
                </ToggleButton>
                <Border Margin="76,0,12,6" Padding="14,9" CornerRadius="6"
                        Background="#CC0D1524" BorderBrush="{DynamicResource ClearCLine}"
                        BorderThickness="2,1,1,1" IsVisible="{Binding IsExpanded}">
                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                 Foreground="{DynamicResource ClearCText2}" Text="说明" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}"
                                 Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                 Foreground="{DynamicResource ClearCText2}" Text="路径" />
                      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                 Foreground="{DynamicResource ClearCCyan}" Text="{Binding Location}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11"
                                 Foreground="{DynamicResource ClearCText2}" Text="建议" />
                      <TextBlock FontSize="12" Foreground="{DynamicResource ClearCText2}"
                                 Text="{Binding Recommendation}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClearC.Desktop.ViewModels"
             x:Class="ClearC.Desktop.Views.WorkflowOverlayView"
             x:DataType="vm:WorkflowOverlayViewModel"
             IsHitTestVisible="{Binding IsConfirmationVisible}">
  <Grid>
    <Border Background="#B503060C" IsVisible="{Binding IsConfirmationVisible}">
      <Border Width="420" MaxHeight="510" Padding="22,20,22,18" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="10" Background="{DynamicResource ClearCBg1}"
              BorderBrush="{DynamicResource ClearCLineStrong}" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold" Text="确认清理" />
          <Border Grid.Row="1" Width="34" Height="2" Margin="0,7,0,10" HorizontalAlignment="Left"
                  Background="{DynamicResource ClearCCyan}" />
          <StackPanel Grid.Row="2" Spacing="9">
            <TextBlock FontSize="12.5" Foreground="{DynamicResource ClearCText2}" Text="即将清理以下项目：" />
            <Border MaxHeight="220" Padding="12,7" CornerRadius="6"
                    Background="#990D1524" BorderBrush="{DynamicResource ClearCLine}" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupItemViewModel">
                      <Grid Margin="0,4" ColumnDefinitions="*,Auto">
                        <TextBlock Foreground="{DynamicResource ClearCText2}" Text="{Binding DisplayName}" />
                        <TextBlock Grid.Column="1" FontFamily="{DynamicResource ClearCMonoFont}" FontWeight="SemiBold"
                                   Text="{Binding SizeText}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
          <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
            <TextBlock FontWeight="SemiBold" Text="合计释放" />
            <TextBlock Grid.Column="1" FontFamily="{DynamicResource ClearCMonoFont}" FontWeight="Bold"
                       Foreground="{DynamicResource ClearCCyanBright}" Text="{Binding ConfirmationTotal}" />
          </Grid>
          <Border Grid.Row="4" Margin="0,10,0,0" Padding="10" CornerRadius="6"
                  Background="#14FBBF24" BorderBrush="#4DFBBF24" BorderThickness="1">
            <TextBlock FontSize="12" Foreground="{DynamicResource ClearCAmber}"
                       Text="{Binding ConfirmationWarning}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Grid.Row="5" Margin="0,16,0,0" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right">
            <Button Classes="ghost" Command="{Binding CancelConfirmationCommand}" Content="取消" />
            <Button Classes="primary" Command="{Binding ConfirmCleanupCommand}" Content="开始清理" />
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border Margin="0,0,18,18" Padding="16,11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            CornerRadius="7" Background="{DynamicResource ClearCBg1}" BorderBrush="{DynamicResource ClearCGreen}"
            BorderThickness="3,1,1,1" IsVisible="{Binding IsToastVisible}">
      <TextBlock FontFamily="{DynamicResource ClearCMonoFont}" FontSize="11.5" Text="{Binding ToastText}" />
    </Border>
  </Grid>
</UserControl>

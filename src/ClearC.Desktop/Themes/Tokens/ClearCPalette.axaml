<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 应用语义画刷绑定共享 Studio / Semi 令牌，切换配色时保留布局与画刷实例。 -->

  <SolidColorBrush x:Key="ClearCBg" Color="{DynamicResource StudioSurfaceColor}" />
  <SolidColorBrush x:Key="ClearCWin" Color="{DynamicResource StudioBackgroundColor}" />
  <SolidColorBrush x:Key="ClearCPanel" Color="{DynamicResource StudioSurfaceColor}" />
  <SolidColorBrush x:Key="ClearCLine" Color="{DynamicResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ClearCLine2" Color="{DynamicResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ClearCText" Color="{DynamicResource StudioTextColor}" />
  <SolidColorBrush x:Key="ClearCText2" Color="{DynamicResource StudioMutedColor}" />
  <SolidColorBrush x:Key="ClearCText3" Color="{DynamicResource StudioMutedColor}" />

  <SolidColorBrush x:Key="ClearCAccent" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="ClearCAccent2" Color="{DynamicResource StudioSecondaryColor}" />
  <SolidColorBrush x:Key="ClearCAccentSoft" Color="{DynamicResource StudioAccentColor}" Opacity="0.08" />
  <SolidColorBrush x:Key="ClearCAccentBorder" Color="{DynamicResource StudioAccentColor}" Opacity="0.35" />
  <SolidColorBrush x:Key="ClearCSecondarySoft" Color="{DynamicResource StudioSecondaryColor}" Opacity="0.1" />
  <SolidColorBrush x:Key="ClearCGreen" Color="{DynamicResource SemiGreen5Color}" />
  <SolidColorBrush x:Key="ClearCAmber" Color="{DynamicResource SemiOrange5Color}" />
  <SolidColorBrush x:Key="ClearCRed" Color="{DynamicResource SemiRed5Color}" />

  <LinearGradientBrush x:Key="ClearCAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="{DynamicResource StudioGradientStartColor}" />
    <GradientStop Offset="1" Color="{DynamicResource StudioSecondaryColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ClearCTextGradient" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="{DynamicResource StudioGradientStartColor}" />
    <GradientStop Offset="1" Color="{DynamicResource StudioSecondaryColor}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ClearCDangerGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Offset="0" Color="#ef4444" />
    <GradientStop Offset="1" Color="#dc2626" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="ClearCDonutTrack" Color="{DynamicResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="ClearCProgressTrack" Color="{DynamicResource StudioRaisedColor}" />

  <SolidColorBrush x:Key="ClearCWindowBorder" Color="{DynamicResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ClearCTitleHover" Color="{DynamicResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="ClearCTitleCloseHover" Color="{DynamicResource SemiRed1Color}" />
  <SolidColorBrush x:Key="ClearCRowHover" Color="{DynamicResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="ClearCRowCurrentBg" Color="{DynamicResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="ClearCRowCurrentBorder" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="ClearCDividerSoft" Color="{DynamicResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ClearCTagBg" Color="{DynamicResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="ClearCCountBg" Color="{DynamicResource StudioRaisedColor}" />
  <SolidColorBrush x:Key="ClearCStatusBg" Color="{DynamicResource StudioSurfaceColor}" />
  <SolidColorBrush x:Key="ClearCConsoleBg" Color="{DynamicResource StudioSurfaceColor}" />

  <SolidColorBrush x:Key="ClearCRiskLowText" Color="{DynamicResource SemiGreen5Color}" />
  <SolidColorBrush x:Key="ClearCRiskLowBg" Color="{DynamicResource SemiGreen0Color}" />
  <SolidColorBrush x:Key="ClearCRiskMidText" Color="{DynamicResource SemiOrange5Color}" />
  <SolidColorBrush x:Key="ClearCRiskMidBg" Color="{DynamicResource SemiOrange0Color}" />
  <SolidColorBrush x:Key="ClearCRiskHighText" Color="{DynamicResource SemiRed5Color}" />
  <SolidColorBrush x:Key="ClearCRiskHighBg" Color="{DynamicResource SemiRed0Color}" />

  <SolidColorBrush x:Key="ClearCLogText" Color="{DynamicResource StudioTextColor}" />
  <SolidColorBrush x:Key="ClearCLogTime" Color="{DynamicResource StudioMutedColor}" />
  <SolidColorBrush x:Key="ClearCLogInfo" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="ClearCLogOk" Color="{DynamicResource SemiGreen5Color}" />
  <SolidColorBrush x:Key="ClearCLogWarn" Color="{DynamicResource SemiOrange5Color}" />
  <SolidColorBrush x:Key="ClearCLogErr" Color="{DynamicResource SemiRed5Color}" />

  <SolidColorBrush x:Key="ClearCMask" Color="#521e2948" />
  <SolidColorBrush x:Key="ClearCWarnBg" Color="{DynamicResource SemiOrange0Color}" />
  <SolidColorBrush x:Key="ClearCWarnBorder" Color="{DynamicResource SemiOrange3Color}" />
  <SolidColorBrush x:Key="ClearCWarnText" Color="{DynamicResource SemiOrange6Color}" />

  <SolidColorBrush x:Key="ClearCScrollThumb" Color="{DynamicResource StudioBorderColor}" />
  <SolidColorBrush x:Key="ClearCScrollThumbHover" Color="{DynamicResource StudioMutedColor}" />
</ResourceDictionary>

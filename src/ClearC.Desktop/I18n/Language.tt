using System;

namespace ClearC.Desktop.I18n;

/// <summary>ClearC 应用国际化资源键。</summary>
public static class Language
{
<#
    string templateDirectory = Path.GetDirectoryName(Host.TemplateFile)!;
    var jsonPath = Path.Combine(templateDirectory, "zh-CN.json");
    using var document = JsonDocument.Parse(File.ReadAllText(jsonPath));
    var keys = new List<string>();
    Collect(document.RootElement, string.Empty, keys);
    foreach (var key in keys.Distinct(StringComparer.Ordinal))
    {
        var field = Sanitize(key.StartsWith("ClearC.", StringComparison.Ordinal) ? key["ClearC.".Length..] : key);
#>    public const string <#= field #> = "<#= key #>";
<#
    }

    void Collect(JsonElement element, string prefix, List<string> result)
    {
        if (element.ValueKind != JsonValueKind.Object) return;
        foreach (var property in element.EnumerateObject())
        {
            if (prefix.Length == 0 && (property.Name is "language" or "cultureName" or "description")) continue;
            var key = prefix.Length == 0 ? property.Name : prefix + "." + property.Name;
            if (property.Value.ValueKind == JsonValueKind.Object) Collect(property.Value, key, result);
            else result.Add(key);
        }
    }

    string Sanitize(string key)
    {
        var chars = key.Where(char.IsLetterOrDigit).ToArray();
        return chars.Length == 0 ? "Unnamed" : new string(chars);
    }
#>
}

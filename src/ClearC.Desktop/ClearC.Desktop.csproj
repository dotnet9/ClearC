  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClearC.Core\ClearC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClearC.Desktop.Tests" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <BuiltInComInteropSupport Condition="'$(TargetFramework)' == 'net10.0-windows'">true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-x86'">true</PublishAot>
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != ''">true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Roots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="CodeWF.Avalonia.Controls" />
    <PackageReference Include="CodeWF.Avalonia.Lang" />
    <PackageReference Include="CodeWF.Toolkit.Core" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="CodeWF.Toolkit.Logging" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClearC.Core\ClearC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClearC.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="I18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>I18n\%(Filename)%(Extension)</TargetPath>
    </None>
    <None Update="I18n\Language.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Language.cs</LastGenOutput>
    </None>
    <Compile Update="I18n\Language.cs">
      <DependentUpon>Language.tt</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

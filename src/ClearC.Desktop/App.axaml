<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="ClearC.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <StyleInclude Source="avares://Semi.Avalonia.DataGrid/DataGridSemiTheme.axaml" />
    <StyleInclude Source="/Themes/Index.axaml" />
  </Application.Styles>
</Application>

# Auto detect text files and perform LF normalization
* text=auto

# 源码与文档统一 LF，Windows 批处理保持 CRLF（与 .editorconfig 一致）。
*.cs text eol=lf
*.axaml text eol=lf
*.xaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.ps1 text eol=lf
*.manifest text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ico binary
*.png binary
